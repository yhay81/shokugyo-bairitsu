{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shokugyo-bairitsu",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "shokugyo-bairitsu.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shokugyo-bairitsu",
      "database_id": "0a7061fb-6a0b-4603-b32f-371e40fa754b",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
